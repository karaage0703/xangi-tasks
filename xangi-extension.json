{
  "schemaVersion": 2,
  "id": "xangi-tasks",
  "displayName": "xangi-tasks",
  "description": "タスク・カテゴリを管理。リンクのtaskパラメータまたはIDでGET /api/tasks/<ID>?history=0、PUT /api/tasks/<ID>で取得・更新",
  "version": "0.1.0",
  "entrypoint": "scripts/xangi-extension",
  "runtime": {
    "kind": "managed-http"
  },
  "permissions": [
    "ローカルのタスクデータを保存し、タスクの閲覧・追加・実行・完了・削除を行う"
  ],
  "setup": {
    "instructions": "XANGI_SETUP.md"
  },
  "ui": {
    "capability": "xangi-tasks.manage",
    "path": "/"
  },
  "capabilities": [
    {
      "id": "xangi-tasks.manage",
      "protocol": "http",
      "healthPath": "/api/health"
    }
  ]
}
