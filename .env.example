# The host URL is provided by xangi. Set XANGI_URL only to override it.
# XANGI_URL=
# XANGI_TOKEN=
XANGI_PROVIDER=codex
XANGI_TASKS_DATA=.data/tasks.json
XANGI_TASKS_POLL_MS=3000

# Reuse the existing xs-notion-manager key; never send the key to browsers.
# Default: ~/.config/notion/api_key (same OS user as xangi).
# XANGI_TASKS_NOTION_KEY_FILE=/absolute/path/to/notion/api_key
