# The parent host URL is provided by xangi. Set XANGI_URL only for an explicit remote destination.
# XANGI_URL=
# XANGI_TOKEN=
XANGI_PROVIDER=codex
# Default: <workspace>/.xangi-tasks/instance-<instance-id>/tasks.json.
# Set an absolute persistent path outside the repository before host-managed updates.
# XANGI_TASKS_DATA=/absolute/path/to/persistent/tasks.json
XANGI_TASKS_POLL_MS=3000

# Reuse the existing xs-notion-manager key; never send the key to browsers.
# Default: ~/.config/notion/api_key (same OS user as xangi).
# XANGI_TASKS_NOTION_KEY_FILE=/absolute/path/to/notion/api_key
